# Contrato de configuracion de catalogo-app.
# Copiar este archivo como .env y completar DB_PASSWORD antes de iniciar.
# No almacenar contrasenas reales en este archivo versionado.

# catalogo-frontend: nginx usa estos valores para alcanzar la API.
API_HOST=catalogo-api
API_PORT=8000

# catalogo-api: conexion con MongoDB.
# catalogo-db reutiliza DB_USER y DB_PASSWORD como credenciales iniciales.
DB_HOST=catalogo-db
DB_PORT=27017
DB_NAME=catalogodb
DB_USER=catalogo_user
DB_PASSWORD=

# catalogo-api: comportamiento de FastAPI.
APP_VERSION=v1
ROOT_PATH=/api
SEED_DEMO=true

# catalogo-api: alternativa opcional a las variables DB_* de conexion.
# Esta cadena contiene la contrasena completa. En Kubernetes debe guardarse
# en un Secret y nunca en un ConfigMap.
MONGO_URI=
